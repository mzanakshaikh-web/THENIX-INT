
/* THENIX INT. DESIGN SYSTEM */

:root {
  --background: #080D0A;
  --surface: #101812;
  --green: #39FF72;
  --white: #FFFFFF;
  --muted: #929C94;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  background: var(--background);
  color: var(--white);
  font-family: Arial, sans-serif;
}

/* OPENING SCREEN */

#intro-screen {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: var(--background);

  display: flex;
  align-items: center;
  justify-content: center;

  animation: introExit 1s ease 3s forwards;
}

.intro-content {
  text-align: center;
}

.intro-logo {
  font-size: 38px;
  font-weight: 900;
  letter-spacing: 5px;
  opacity: 0;
  animation: logoFade 1.2s ease forwards;
}

.intro-logo span {
  color: var(--green);
}

.developer-credit {
  margin-top: 12px;
  font-size: 11px;
  letter-spacing: 3px;
  color: var(--muted);
  opacity: 0;
  animation: creditFade 1.5s ease 0.8s forwards;
}

@keyframes logoFade {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes creditFade {
  to {
    opacity: 0.8;
  }
}

@keyframes introExit {
  to {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
}

/* NAVIGATION */

.navbar {
  min-height: 75px;
  padding: 20px 7%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #1b2920;
}

.brand {
  color: white;
  font-size: 23px;
  font-weight: 900;
  text-decoration: none;
}

.brand span {
  color: var(--green);
}

nav {
  display: flex;
  gap: 25px;
  align-items: center;
}

nav a {
  color: var(--muted);
  text-decoration: none;
}

nav a:hover {
  color: var(--green);
}

nav button {
  background: var(--green);
  color: #080D0A;
  padding: 11px 20px;
  border: none;
  border-radius: 5px;
  font-weight: bold;
}

.menu-toggle {
  display: none;
  background: none;
  color: white;
  border: none;
  font-size: 25px;
}

/* HERO */

.hero {
  padding: 90px 7%;
  min-height: 550px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 40px;
}

.eyebrow {
  color: var(--green);
  letter-spacing: 3px;
  font-size: 11px;
  font-weight: bold;
  margin-bottom: 20px;
}

.hero h1 {
  font-size: clamp(42px, 7vw, 75px);
  line-height: 1;
  margin-bottom: 25px;
}

.hero h1 span,
.section-heading h2 span,
.community h2 span {
  color: var(--green);
}

.hero-description {
  color: var(--muted);
  line-height: 1.8;
  max-width: 450px;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 15px;
  margin-top: 30px;
}

.primary-btn,
.secondary-btn {
  padding: 15px 22px;
  font-weight: bold;
  text-decoration: none;
  border-radius: 5px;
  cursor: pointer;
}

.primary-btn {
  background: var(--green);
  color: var(--background);
  border: none;
}

.secondary-btn {
  color: white;
  border: 1px solid #526056;
}

/* HERO IMAGE PLACEHOLDER */

.hero-image-placeholder {
  min-height: 320px;
  background: linear-gradient(135deg, #14251a, #080D0A);
  border: 1px solid #254b30;
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 15px;
}

.hero-image-placeholder span {
  font-size: 28px;
  font-weight: 900;
  color: var(--green);
}

.hero-image-placeholder p {
  font-size: 10px;
  letter-spacing: 3px;
  color: white;
}

/* FEATURES */

.features {
  padding: 80px 7%;
  background: #0C120E;
}

.section-heading {
  text-align: center;
  margin-bottom: 40px;
}

.section-heading h2 {
  font-size: 32px;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}

.feature-card {
  padding: 25px;
  background: var(--surface);
  border: 1px solid #203126;
  border-radius: 10px;
}

.feature-icon {
  color: var(--green);
  font-size: 25px;
  font-weight: bold;
  margin-bottom: 20px;
}

.feature-card h3 {
  margin-bottom: 12px;
}

.feature-card p {
  color: var(--muted);
  line-height: 1.7;
}

/* COMMUNITY */

.community {
  text-align: center;
  padding: 100px 7%;
}

.community h2 {
  font-size: 38px;
  line-height: 1.3;
}

.community > p:not(.eyebrow) {
  color: var(--muted);
  margin: 20px 0;
}

/* FOOTER */

.footer {
  padding: 35px 7%;
  text-align: center;
  border-top: 1px solid #203126;
}

.footer p {
  margin-top: 15px;
  font-size: 11px;
  color: var(--muted);
}

/* MOBILE RESPONSIVENESS */

@media (max-width: 700px) {

  .navbar {
    padding: 18px 5%;
  }

  .menu-toggle {
    display: block;
  }

  nav {
    display: none;
    position: absolute;
    top: 70px;
    left: 0;
    width: 100%;
    padding: 25px;
    background: #101812;
    flex-direction: column;
    z-index: 10;
  }

  nav.active {
    display: flex;
  }

  .hero {
    padding: 65px 6%;
    grid-template-columns: 1fr;
  }

  .hero h1 {
    font-size: 48px;
  }

  .feature-grid {
    grid-template-columns: 1fr;
  }

  .community h2 {
    font-size: 30px;
  }

}
